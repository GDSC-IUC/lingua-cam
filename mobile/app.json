{
  "expo": {
    "name": "",
    "slug": "nkolo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-app.jpg",
    "scheme": "nkolo",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/logo-app.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#006850"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.nkolo.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Lingua-Cam utilise le micro pour les exercices de prononciation",
        "NSSpeechRecognitionUsageDescription": "Lingua-Cam utilise la reconnaissance vocale pour corriger ta prononciation",
        "NSCameraUsageDescription": "Lingua-Cam peut utiliser la caméra pour personnaliser ton avatar"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#007A5E"
      },
      "package": "app.nkolo.mobile",
      "permissions": [
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ],
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Lingua-Cam utilise le micro pour les exercices de prononciation en langue camerounaise."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-app.jpg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#006850"
        }
      ],
      "expo-sqlite",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
